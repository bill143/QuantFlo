# ───────────────────────── QUANTFLO environment (EXAMPLE) ─────────────────────────
# Copy to `.env` and fill locally. NEVER commit real values. `.env` is gitignored.
# Phase 0 declares the config SURFACE only; no live endpoints or secrets are used.
# Settings are read with the `QUANTFLO_` prefix (see quantflo/core/config/settings.py).

# ── Runtime ──
QUANTFLO_ENVIRONMENT=development          # development | staging | production
QUANTFLO_LOG_LEVEL=INFO

# ── Datastore (Phase 1+) ──
QUANTFLO_DATABASE_URL=                    # e.g. postgresql+psycopg://user:pass@host:5432/quantflo
QUANTFLO_REDIS_URL=                       # e.g. redis://localhost:6379/0  (state bus / queues)

# ── Secrets / KMS / Vault (Phase 1) ──
QUANTFLO_VAULT_ADDR=                      # e.g. https://vault.internal:8200
QUANTFLO_KMS_KEY_ID=                      # cloud KMS / vault key identifier

# ── Broker / execution (later phase) — sim first, never live in Phase 0/1 ──
QUANTFLO_BROKER_NAME=                     # e.g. tradovate
QUANTFLO_BROKER_ACCOUNT_ID=
QUANTFLO_BROKER_API_BASE_URL=             # e.g. https://demo.tradovateapi.com/v1
# Broker credentials live in the vault, NOT here. Declared for surface awareness:
# QUANTFLO_BROKER_API_KEY=
# QUANTFLO_BROKER_API_SECRET=

# ── Market data (later phase) ──
QUANTFLO_MARKET_DATA_PROVIDER=            # e.g. databento | rithmic | dxfeed
QUANTFLO_MARKET_DATA_API_BASE_URL=
# QUANTFLO_MARKET_DATA_API_KEY=           # vault-sourced in real deployments

# ── Orchestration (ruflo backbone) ──
QUANTFLO_RUFLO_ENABLED=false             # bridge Python skeleton to the ruflo runtime (Phase 1)
