# QUANTFLO environment (EXAMPLE). Copy to .env and fill locally. NEVER commit real
# values. .env is gitignored. Settings use the QUANTFLO_ prefix
# (quantflo/core/config/settings.py). Non-prefixed vars (POSTGRES_*) are read by
# docker-compose only.
#
# IMPORTANT: put comments on their OWN lines. An inline comment after an EMPTY value
# (e.g. `KEY=   # note`) is captured as the value by the .env parser.

# Runtime
QUANTFLO_ENVIRONMENT=development
QUANTFLO_LOG_LEVEL=INFO
QUANTFLO_TENANT_ID=local

# Datastore (matches infra/docker/docker-compose.yml; host ports 15432 / 16379)
QUANTFLO_DATABASE_URL=postgresql+asyncpg://quantflo:quantflo_local_dev@localhost:15432/quantflo
QUANTFLO_REDIS_URL=redis://localhost:16379/0
# Postgres container credentials (docker-compose only; keep in sync with DATABASE_URL)
POSTGRES_USER=quantflo
POSTGRES_PASSWORD=quantflo_local_dev
POSTGRES_DB=quantflo

# Market data provider (Databento — see docs/decisions/0003)
QUANTFLO_MARKET_DATA_PROVIDER=databento
# Paste your Databento key below (format: db-...)
QUANTFLO_DATABENTO_API_KEY=

# Secrets / KMS vault. KMS_PROVIDER: local (dev emulator, flagged) or aws (real AWS KMS)
QUANTFLO_KMS_PROVIDER=local
QUANTFLO_AWS_REGION=us-east-1
# AWS KMS key ARN (required when KMS_PROVIDER=aws)
QUANTFLO_KMS_KEY_ARN=
# Local KMS emulator master key (dev only). Blank => generated under .secrets/ (gitignored).
QUANTFLO_LOCAL_KMS_MASTER_KEY=

# Observability — paste the Sentry DSN below
QUANTFLO_SENTRY_DSN=

# Broker / execution (LATER phase — unused in Phase 1)
QUANTFLO_BROKER_NAME=
QUANTFLO_BROKER_ACCOUNT_ID=
QUANTFLO_BROKER_API_BASE_URL=

# Orchestration
QUANTFLO_RUFLO_ENABLED=false
