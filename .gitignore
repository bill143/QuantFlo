# ───────────────────────────── QUANTFLO .gitignore ─────────────────────────────

# Research clones (Stage 1 analysis sources) — never committed
/_research/

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# Virtual environments
.venv/
venv/
env/
ENV/

# ── Node / Next.js (ruflo backbone + dashboard) ──
node_modules/
.next/
out/
.npm/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environment / secrets ── (NEVER commit real credentials)
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/
*.secret

# ── Data dumps ──
data/raw/
data/processed/
data/dumps/
*.csv
*.parquet
*.feather
*.h5
*.hdf5
*.sqlite
*.db
*.dump

# ── IDE / editor ──
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ──
logs/
*.log
